# Startup file for Glance Dock's terminal tabs: your normal ~/.bashrc first
# (prompt, aliases, conda init), then the conda env chosen in Preferences.
# Your .bashrc activates "base", so the env has to come after it.
[ -f ~/.bashrc ] && . ~/.bashrc
if [ -n "$GLANCE_CONDA_ENV" ] && command -v conda >/dev/null 2>&1; then
    conda activate "$GLANCE_CONDA_ENV" 2>/dev/null || echo "glance terminal: conda env '$GLANCE_CONDA_ENV' not found"
fi
